# Postgres connection string. A free dedicated Supabase project ("weekend-planner",
# project ref vhipuawqafnpakjiopmk) has already been provisioned and has the schema
# applied — see PROGRESS.md/README.md for how to get its real connection string (the DB
# password isn't retrievable via API, so that one step is a dashboard visit).
#
# IMPORTANT: use the Session Pooler connection string, NOT the direct connection. The
# direct connection (db.<ref>.supabase.co) is IPv6-only on Supabase's free tier, and
# several hosts (Render included) don't support outbound IPv6 — it fails at boot with
# ENETUNREACH. The Session pooler is IPv4 and is also the right choice for a persistent
# server like this one (vs. the Transaction pooler, meant for serverless). Format:
# postgres://postgres.vhipuawqafnpakjiopmk:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/weekend_planner

# Anthropic API key used at runtime to compose itineraries (feature 7). This is a
# separate key from any Claude Code/Cowork subscription — create one at
# https://console.anthropic.com/ if you don't already have one. NEVER commit the real
# value; set it in Render's service environment variables.
ANTHROPIC_API_KEY=sk-ant-placeholder

# Optional: override the Claude model used for itinerary composition.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Render sets PORT automatically in production; only needed for local runs.
PORT=3000

NODE_ENV=development

# Postgres connection string. On Railway, attach a Postgres add-on to this service
# and Railway will inject DATABASE_URL automatically — you generally don't need to set
# this by hand there. For local/dev use only if you ever run this outside Railway.
DATABASE_URL=postgres://user:password@localhost:5432/weekend_planner

# Anthropic API key used at runtime to compose itineraries (feature 7). This is a
# separate key from any Claude Code/Cowork subscription — create one at
# https://console.anthropic.com/ if you don't already have one. NEVER commit the real
# value; set it in Railway's service variables.
ANTHROPIC_API_KEY=sk-ant-placeholder

# Optional: override the Claude model used for itinerary composition.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Railway sets PORT automatically in production; only needed for local runs.
PORT=3000

NODE_ENV=development

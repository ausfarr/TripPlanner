# Postgres connection string. A free dedicated Supabase project ("weekend-planner",
# project ref vhipuawqafnpakjiopmk) has already been provisioned and has the schema
# applied — see PROGRESS.md for how to get its real connection string (the DB password
# isn't retrievable via API, so that one step is a dashboard visit). Format:
# postgres://postgres:[PASSWORD]@db.vhipuawqafnpakjiopmk.supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/weekend_planner

# Anthropic API key used at runtime to compose itineraries (feature 7). This is a
# separate key from any Claude Code/Cowork subscription — create one at
# https://console.anthropic.com/ if you don't already have one. NEVER commit the real
# value; set it in Render's service environment variables.
ANTHROPIC_API_KEY=sk-ant-placeholder

# Optional: override the Claude model used for itinerary composition.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Render sets PORT automatically in production; only needed for local runs.
PORT=3000

NODE_ENV=development
